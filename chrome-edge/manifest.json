{
  "manifest_version": 3,
  "name": "ČHMÚ Classic – meteorologické výstupy",
  "version": "0.7.0.19",
  "version_name": "0.7.0-beta.19",
  "description": "Vrací klasický vzhled živým meteorologickým aplikacím ČHMÚ a přidává přehledný rozcestník.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://produkty.chmi.cz/radar/*",
    "https://produkty.chmi.cz/druzice/*",
    "https://produkty.chmi.cz/aladin/*",
    "https://www.chmi.cz/*",
    "https://hydro.chmi.cz/*",
    "https://intranet.chmi.cz/*",
    "http://intranet.chmi.cz/*",
    "https://portal.chmi.cz/*",
    "http://portal.chmi.cz/*"
  ],
  "action": {
    "default_title": "ČHMÚ Classic – meteorologické výstupy",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chmi.cz/",
        "https://www.chmi.cz/?*",
        "https://www.chmi.cz/uvod*"
      ],
      "css": [
        "classic.css", "navigation.css", "catalog.css", "portal.css"
      ],
      "js": [
        "portal-registry.js", "portal.js", "navigation.js", "content.js", "catalog.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://produkty.chmi.cz/radar/*",
        "https://produkty.chmi.cz/druzice/*",
        "https://produkty.chmi.cz/aladin/*",
        "https://www.chmi.cz/namerena-data/pravdepodobnost-rustu-hub*",
        "https://www.chmi.cz/namerena-data/polarni-druzice/*",
        "https://www.chmi.cz/namerena-data/geostacionarni-druzice/*",
        "https://www.chmi.cz/namerena-data/webkamery*",
        "https://www.chmi.cz/namerena-data/webkamera/*"
      ],
      "css": [
        "classic.css", "satellite.css", "navigation.css", "catalog.css",
        "aladin.css", "embedded.css", "webcams.css"
      ],
      "js": [
        "portal-registry.js", "embedded.js", "navigation.js", "content.js",
        "satellite.js", "aladin.js", "catalog.js", "webcams.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.chmi.cz/meteogram/*"
      ],
      "css": [
        "navigation.css", "catalog.css", "meteogram.css", "embedded.css"
      ],
      "js": [
        "portal-registry.js", "embedded.js", "catalog.js", "meteogram.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.chmi.cz/predpoved-pocasi/dnes*",
        "https://www.chmi.cz/predpoved-pocasi/zitra*",
        "https://www.chmi.cz/predpoved-pocasi/pozitri*",
        "https://www.chmi.cz/voda/aktualni-stav-rek-povodnova-mapa*",
        "https://www.chmi.cz/namerena-data/data-z-mericich-stanic/aktualni-mapy-kvality-ovzdusi-cr*"
      ],
      "css": [
        "portal.css", "embedded.css", "forecast.css"
      ],
      "js": [
        "portal-registry.js", "embedded.js", "portal.js", "forecast.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://hydro.chmi.cz/hppsoldv/main_rain.php*"
      ],
      "css": [
        "embedded.css", "rainfall.css"
      ],
      "js": [
        "portal-registry.js", "embedded.js", "rainfall.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.chmi.cz/predpoved-pocasi/synopticka-situace*"
      ],
      "css": [
        "embedded.css", "navigation.css", "synoptic.css"
      ],
      "js": [
        "portal-registry.js", "embedded.js", "navigation.js", "synoptic.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.chmi.cz/letectvi/aerologicka-data/11520-praha-libus-emagram-100hpa*"
      ],
      "css": [
        "embedded.css", "navigation.css", "sonde.css"
      ],
      "js": [
        "portal-registry.js", "embedded.js", "navigation.js", "sonde.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.chmi.cz/namerena-data/merici-stanice/meteorologicke/p1pkle01-praha-klementinum*"
      ],
      "css": [
        "embedded.css", "navigation.css", "klementinum.css"
      ],
      "js": [
        "portal-registry.js", "embedded.js", "navigation.js", "klementinum.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.chmi.cz/namerena-data/umisteni-mericich-stanic/meteorologicke*"
      ],
      "css": [
        "embedded.css", "navigation.css", "stations.css"
      ],
      "js": [
        "portal-registry.js", "embedded.js", "navigation.js", "stations.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.chmi.cz/predpoved-pocasi/rizika/aktivita-klistat*"
      ],
      "css": [
        "embedded.css", "navigation.css", "ticks.css"
      ],
      "js": [
        "portal-registry.js", "embedded.js", "navigation.js", "ticks.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.chmi.cz/*",
        "https://hydro.chmi.cz/*"
      ],
      "exclude_matches": [
        "https://www.chmi.cz/",
        "https://www.chmi.cz/?*",
        "https://www.chmi.cz/uvod*",
        "https://www.chmi.cz/namerena-data/pravdepodobnost-rustu-hub*",
        "https://www.chmi.cz/namerena-data/polarni-druzice/*",
        "https://www.chmi.cz/namerena-data/geostacionarni-druzice/*",
        "https://www.chmi.cz/namerena-data/webkamery*",
        "https://www.chmi.cz/namerena-data/webkamera/*",
        "https://www.chmi.cz/meteogram/*",
        "https://www.chmi.cz/predpoved-pocasi/dnes*",
        "https://www.chmi.cz/predpoved-pocasi/zitra*",
        "https://www.chmi.cz/predpoved-pocasi/pozitri*",
        "https://www.chmi.cz/voda/aktualni-stav-rek-povodnova-mapa*",
        "https://www.chmi.cz/namerena-data/data-z-mericich-stanic/aktualni-mapy-kvality-ovzdusi-cr*",
        "https://hydro.chmi.cz/hppsoldv/main_rain.php*",
        "https://www.chmi.cz/predpoved-pocasi/synopticka-situace*",
        "https://www.chmi.cz/letectvi/aerologicka-data/11520-praha-libus-emagram-100hpa*",
        "https://www.chmi.cz/namerena-data/merici-stanice/meteorologicke/p1pkle01-praha-klementinum*",
        "https://www.chmi.cz/namerena-data/umisteni-mericich-stanic/meteorologicke*",
        "https://www.chmi.cz/predpoved-pocasi/rizika/aktivita-klistat*"
      ],
      "css": [
        "navigation.css",
        "catalog.css"
      ],
      "js": [
        "catalog.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://intranet.chmi.cz/*",
        "http://intranet.chmi.cz/*",
        "https://portal.chmi.cz/*",
        "http://portal.chmi.cz/*",
        "https://www.chmi.cz/files/portal/docs/meteo/*",
        "http://www.chmi.cz/files/portal/docs/meteo/*"
      ],
      "css": [
        "legacy.css"
      ],
      "js": [
        "legacy.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
