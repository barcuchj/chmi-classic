{
  "manifest_version": 3,
  "name": "ČHMÚ Classic – meteorologické výstupy",
  "version": "0.5.0",
  "description": "Vrací kompaktní klasické rozhraní radaru, družicím a dalším živým meteorologickým výstupům ČHMÚ a přidává jednotný katalog.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://produkty.chmi.cz/radar/*",
    "https://produkty.chmi.cz/druzice/*",
    "https://produkty.chmi.cz/aladin/*",
    "https://www.chmi.cz/*",
    "https://hydro.chmi.cz/*"
  ],
  "action": {
    "default_title": "ČHMÚ Classic – meteorologické výstupy",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://produkty.chmi.cz/radar/*",
        "https://www.chmi.cz/namerena-data/pravdepodobnost-rustu-hub*",
        "https://www.chmi.cz/"
      ],
      "css": [
        "classic.css",
        "navigation.css",
        "catalog.css"
      ],
      "js": [
        "navigation.js",
        "content.js",
        "catalog.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://produkty.chmi.cz/druzice/*",
        "https://www.chmi.cz/namerena-data/polarni-druzice/*",
        "https://www.chmi.cz/namerena-data/geostacionarni-druzice/*"
      ],
      "css": [
        "satellite.css",
        "navigation.css",
        "catalog.css"
      ],
      "js": [
        "navigation.js",
        "satellite.js",
        "catalog.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://produkty.chmi.cz/aladin/*",
        "https://www.chmi.cz/*",
        "https://hydro.chmi.cz/*"
      ],
      "exclude_matches": [
        "https://www.chmi.cz/",
        "https://www.chmi.cz/namerena-data/pravdepodobnost-rustu-hub*",
        "https://www.chmi.cz/namerena-data/polarni-druzice/*",
        "https://www.chmi.cz/namerena-data/geostacionarni-druzice/*"
      ],
      "css": [
        "navigation.css",
        "catalog.css"
      ],
      "js": [
        "catalog.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
